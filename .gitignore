# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
*.parquet
dist_footprints/

# Node
node_modules/
dist/
*.tsbuildinfo

# Baked tiles (regenerate with tiler/scripts/bake.py)
client/public/tiles/

# AWS CDK — synth output. Regenerated by `cdk synth`/`cdk deploy`; contains
# rendered templates and the docker asset staging manifest.
infra/cdk.out/
# tsc output next to the CDK sources: `cdk synth` compiles bin/*.ts and lib/*.ts
# in place, so these reappear on every synth. Never committed so far, but they
# are one `git add -A` away from being.
infra/bin/*.js
infra/bin/*.d.ts
infra/lib/*.js
infra/lib/*.d.ts
cdk.context.json

# Dev tile access key — single source of truth, mirrored into
# client/.env.local by infra/deploy.sh. Never commit either.
.tile-key
.env.local
*.local

# Working notes / review punch-list — local only, not part of the repo's docs.
CLEANUP.md

# Playwright test output
client/playwright-report/
client/test-results/

# OS / editor
.DS_Store
