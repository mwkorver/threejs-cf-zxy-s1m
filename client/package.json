{
  "name": "flight-sim-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Flat-Mercator flight-sim client (FLIGHT-SIM-PLAN.md §5): streams NAIP imagery and 3DEP terrain tiles into a three.js renderer (engine settled §10.2). src/core stays engine-agnostic.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/mapbox__vector-tile": "^1.3.4",
    "@types/pbf": "^3.0.5",
    "@types/three": "^0.171.0",
    "three": "^0.171.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "earcut": "^3.2.3",
    "pbf": "^5.1.2"
  }
}
